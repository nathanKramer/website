---
import Layout from "./Layout.astro";

export interface Props {
  title: string;
  description: string;
  date: Date;
  tags?: string[];
}

const { title, description, date, tags = [] } = Astro.props;

const formattedDate = date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<Layout title={title}>
  <link rel="stylesheet" href="/css/prism.css" />
  <main>
    <article>
      <header>
        <a href="/blog" class="back-link">&larr; Back to Blog</a>
        <h1>{title}</h1>
        <p class="meta">
          <time datetime={date.toISOString()}>{formattedDate}</time>
          {tags.length > 0 && (
            <span class="tags">
              {tags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </span>
          )}
        </p>
        <p class="description">{description}</p>
      </header>
      <div class="content">
        <slot />
      </div>
    </article>
  </main>
  <script is:inline src="/js/prism.js"></script>
</Layout>

<style>
  main {
    margin: auto;
    padding: 1.5rem;
    max-width: 90ch;
    color: #aaaaaa;
  }

  article {
    font-family: "Open Sans", sans-serif;
    font-size: 18px;
    line-height: 1.6;
  }

  .back-link {
    color: #f15125;
    text-decoration: none;
    display: inline-block;
    margin-bottom: 1rem;
  }

  .back-link:hover {
    text-decoration: underline;
  }

  header {
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid #333;
  }

  h1 {
    color: #eeeeee;
    font-size: 2.5rem;
    font-weight: 800;
    margin: 0.5rem 0;
    line-height: 1.2;
  }

  .meta {
    color: #888888;
    font-size: 0.9rem;
    margin: 1rem 0;
  }

  .tags {
    margin-left: 1rem;
  }

  .tag {
    background-color: rgba(241, 81, 37, 0.2);
    color: #f15125;
    padding: 0.2rem 0.5rem;
    border-radius: 0.25rem;
    font-size: 0.8rem;
    margin-left: 0.5rem;
  }

  .description {
    color: #bbbbbb;
    font-style: italic;
    margin: 1rem 0;
  }

  .content :global(h2) {
    color: #eeeeee;
    font-size: 1.75rem;
    font-weight: bold;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .content :global(h3) {
    color: #eeeeee;
    font-size: 1.25rem;
    font-weight: bold;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .content :global(p) {
    margin: 1rem 0;
  }

  .content :global(a) {
    color: #f15125;
  }

  .content :global(ul) {
    list-style-type: disc;
    margin: 1rem 0;
    padding-left: 1.5rem;
  }

  .content :global(ol) {
    list-style-type: decimal;
    margin: 1rem 0;
    padding-left: 1.5rem;
  }

  .content :global(li) {
    margin: 0.5rem 0;
  }

  .content :global(blockquote) {
    border-left: 4px solid #f15125;
    padding-left: 1rem;
    margin: 1.5rem 0;
    font-style: italic;
    color: #bbbbbb;
  }

  .content :global(code:not([class*="language-"])) {
    background-color: #1d2021;
    padding: 0.2rem 0.4rem;
    border-radius: 0.25rem;
    font-size: 0.9em;
  }

  .content :global(pre) {
    margin: 1.5rem 0;
  }

  .content :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 0.5rem;
  }

  .content :global(hr) {
    border: none;
    border-top: 1px solid #333;
    margin: 2rem 0;
  }
</style>
