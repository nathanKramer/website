---
// Standalone link page for the "Dialectic I" EP. Uses its own styling rather than the site Layout.
const canonical = new URL("/music", Astro.site).href;
const ogImage = new URL("/music/cover-1200.jpg", Astro.site).href;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <link rel="canonical" href={canonical}>
  <meta property="og:url" content={canonical}>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Dialectic I · Nathan Kramer</title>
  <meta name="description" content="Listen to Dialectic I by Nathan Kramer on Spotify, Apple Music, YouTube, Bandcamp and more.">
  <meta name="theme-color" content="#f9e6bb">

  <!-- Social previews -->
  <meta property="og:type" content="music.album">
  <meta property="og:title" content="Dialectic I">
  <meta property="og:description" content="Nathan Kramer">
  <meta property="og:site_name" content="Nathan Kramer">
  <meta property="og:image" content={ogImage}>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Dialectic I">
  <meta name="twitter:description" content="Nathan Kramer">
  <meta name="twitter:image" content={ogImage}>

  <link rel="icon" type="image/jpeg" href="/music/cover-600.jpg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet">

  <style is:global>
    :root {
      --cream: #f9e6bb;
      --cream-deep: #f3d7a0;
      --paper: #fff6e3;
      --coral: #ec7350;
      --coral-deep: #d65a37;
      --violet: #3b2bd0;
      --ink: #2a1d5c;
      --muted: #7a6a8f;
      --radius: 18px;
    }

    * { box-sizing: border-box; }

    html, body { margin: 0; }

    body {
      min-height: 100vh;
      font-family: "Outfit", system-ui, -apple-system, "Segoe UI", sans-serif;
      color: var(--ink);
      background:
        radial-gradient(ellipse at 50% -10%, #fff3d6 0%, transparent 60%),
        var(--cream);
      display: flex;
      justify-content: center;
      padding: 40px 16px 56px;
      -webkit-font-smoothing: antialiased;
    }

    main {
      width: 100%;
      max-width: 440px;
    }

    .cover {
      display: block;
      width: 100%;
      height: auto;
      aspect-ratio: 1;
      border-radius: var(--radius);
      box-shadow:
        0 1px 2px rgba(42, 29, 92, 0.08),
        0 20px 50px -18px rgba(214, 90, 55, 0.45);
    }

    header {
      text-align: center;
      margin: 28px 0 24px;
    }

    h1 {
      margin: 0;
      font-size: 2rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--coral);
    }

    .artist {
      margin: 6px 0 0;
      font-size: 0.95rem;
      font-weight: 500;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--violet);
    }

    .services {
      list-style: none;
      margin: 0;
      padding: 0;
      background: var(--paper);
      border-radius: var(--radius);
      box-shadow: 0 1px 2px rgba(42, 29, 92, 0.06);
      overflow: hidden;
    }

    .services li + li { border-top: 1px solid var(--cream-deep); }

    .services a {
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 14px 16px;
      color: inherit;
      text-decoration: none;
      transition: background-color 0.15s ease;
    }

    .services a:hover { background: #fdeccb; }
    .services a:focus-visible {
      outline: 3px solid var(--violet);
      outline-offset: -3px;
    }

    .icon {
      flex: none;
      width: 26px;
      height: 26px;
      fill: var(--ink);
    }

    .name {
      flex: 1;
      font-size: 1.05rem;
      font-weight: 500;
    }

    .cta {
      flex: none;
      min-width: 72px;
      padding: 7px 14px;
      border: 2px solid var(--violet);
      border-radius: 999px;
      font-size: 0.8rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-align: center;
      text-transform: uppercase;
      color: var(--violet);
      transition: background-color 0.15s ease, color 0.15s ease;
    }

    .services a:hover .cta {
      background: var(--violet);
      color: var(--paper);
    }

    .socials {
      display: flex;
      justify-content: center;
      gap: 12px;
      margin-top: 32px;
    }

    .socials a {
      display: grid;
      place-items: center;
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: var(--coral);
      transition: background-color 0.15s ease, transform 0.15s ease;
    }

    .socials a:hover {
      background: var(--coral-deep);
      transform: translateY(-2px);
    }

    .socials a:focus-visible {
      outline: 3px solid var(--violet);
      outline-offset: 3px;
    }

    .socials .icon {
      width: 20px;
      height: 20px;
      fill: var(--paper);
    }

    footer {
      margin-top: 20px;
      text-align: center;
      font-size: 0.8rem;
      color: var(--muted);
    }

    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }

    @media (prefers-reduced-motion: reduce) {
      * { transition: none !important; }
    }
  </style>
</head>
