---
import Layout from "../../layouts/Layout.astro";
import BlogCard from "../../components/BlogCard.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const allTags = [...new Set(posts.flatMap((post) => post.data.tags ?? []))].sort();
---

<Layout title="Blog - Nathan Kramer">
  <main>
    <header>
      <h1>Blog</h1>
      <p class="intro">
        Thoughts on software engineering, music, consciousness, and more.
      </p>
    </header>

    <div class="filters">
      <input
        type="text"
        id="search-input"
        class="search-bar"
        placeholder="Search posts..."
      />
      {allTags.length > 0 && (
        <nav class="tag-filters">
          <button class="tag-filter active" data-tag="all">All</button>
          {allTags.map((tag) => (
            <button class="tag-filter" data-tag={tag}>{tag}</button>
          ))}
        </nav>
      )}
      <p class="keys-hint">
        <kbd>j</kbd>/<kbd>k</kbd> navigate · <kbd>enter</kbd> open · <kbd>/</kbd> search
      </p>
    </div>

    <section class="posts">
      {posts.length === 0 ? (
        <p class="no-posts">No posts yet. Check back soon!</p>
      ) : (
        posts.map((post) => (
          <div class="post-item" data-tags={JSON.stringify(post.data.tags ?? [])} data-title={post.data.title.toLowerCase()} data-description={post.data.description.toLowerCase()}>
            <BlogCard
              title={post.data.title}
              description={post.data.description}
              date={post.data.date}
              slug={post.slug}
              tags={post.data.tags}
              author={post.data.author}
              authorImage={post.data.authorImage}
            />
          </div>
        ))
      )}
    </section>
  </main>
</Layout>

<style>
  main {
    margin: auto;
    padding: 1.5rem;
    max-width: 90ch;
    color: #aaaaaa;
  }

  header {
    margin-bottom: 2rem;
  }

  h1 {
    color: #eeeeee;
    font-size: 2.5rem;
    font-weight: 800;
    margin: 0;
  }

  .intro {
    color: #aaaaaa;
    font-size: 1.125rem;
    margin-top: 0.5rem;
  }

  .posts {
    margin-top: 2rem;
  }

  .no-posts {
    color: #888888;
    font-style: italic;
  }

  .filters {
    margin-bottom: 1.5rem;
  }

  .search-bar {
    width: 100%;
    padding: 0.6rem 0.75rem;
    margin-bottom: 0.75rem;
    border: 1px solid #333;
    border-radius: 0.25rem;
    background-color: rgba(255, 255, 255, 0.02);
    color: #eeeeee;
    font-size: 0.95rem;
    outline: none;
    transition: border-color 0.2s ease;
  }

  .search-bar::placeholder {
    color: #666666;
  }

  .search-bar:focus {
    border-color: #f15125;
  }

  .tag-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag-filter {
    background-color: rgba(241, 81, 37, 0.15);
    color: #f15125;
    border: 1px solid transparent;
    padding: 0.3rem 0.75rem;
    border-radius: 0.25rem;
    font-size: 0.85rem;
    cursor: pointer;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .tag-filter:hover {
    background-color: rgba(241, 81, 37, 0.3);
  }

  .tag-filter.active {
    background-color: #f15125;
    color: #ffffff;
  }

  .keys-hint {
    color: #666666;
    font-size: 0.8rem;
    margin: 0.75rem 0 0;
  }

  .keys-hint kbd {
    border: 1px solid #333;
    border-radius: 0.2rem;
    padding: 0.05rem 0.3rem;
    font-family: inherit;
    font-size: 0.75rem;
    color: #999999;
  }

  .post-item.selected :global(.blog-card) {
    border-color: #f15125;
    background-color: rgba(241, 81, 37, 0.08);
    box-shadow: 0 0 0 1px #f15125;
  }

  .post-item.selected :global(.blog-card h2) {
    color: #f15125;
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const buttons = document.querySelectorAll<HTMLButtonElement>(".tag-filter");
    const posts = Array.from(document.querySelectorAll<HTMLElement>(".post-item"));
    const searchInput = document.getElementById("search-input") as HTMLInputElement;
    let activeTag = "all";
    let selected: HTMLElement | null = null;
    let lastKey = "";
    let lastKeyAt = 0;
    let lastRepeatAt = 0;
    // Auto-repeat fires ~30x/sec once the OS repeat delay elapses, which
    // outruns the list. Held j/k advance at this rate instead.
    const REPEAT_MS = 120

    const visiblePosts = () => posts.filter((post) => post.style.display !== "none");

    function select(post: HTMLElement | null, scroll = true) {
      if (selected) selected.classList.remove("selected");
      selected = post;
      if (!post) return;
      post.classList.add("selected");
      if (scroll) post.scrollIntoView({ block: "nearest" });
    }

    function move(delta: number) {
      const visible = visiblePosts();
      if (visible.length === 0) return;
      const current = selected ? visible.indexOf(selected) : -1;
      const next = current === -1
        ? (delta > 0 ? 0 : visible.length - 1)
        : Math.min(visible.length - 1, Math.max(0, current + delta));
      select(visible[next]);
    }

    function openSelected() {
      const link = selected?.querySelector<HTMLAnchorElement>("a[href]");
      if (link) window.location.href = link.href;
    }

    function filterPosts() {
      const query = searchInput.value.toLowerCase();
      posts.forEach((post) => {
        const matchesTag = activeTag === "all" ||
          JSON.parse(post.dataset.tags ?? "[]").includes(activeTag);
        const matchesSearch = !query ||
          post.dataset.title?.includes(query) ||
          post.dataset.description?.includes(query);
        post.style.display = matchesTag && matchesSearch ? "" : "none";
      });
      if (selected && selected.style.display === "none") select(null);
    }

    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        activeTag = button.dataset.tag!;
        buttons.forEach((b) => b.classList.remove("active"));
        button.classList.add("active");
        filterPosts();
      });
    });

    searchInput.addEventListener("input", filterPosts);

    posts.forEach((post) => {
      post.addEventListener("mouseenter", () => select(post, false));
    });

    document.addEventListener("keydown", (event) => {
      const target = event.target as HTMLElement | null;
      const typing = target instanceof HTMLInputElement ||
        target instanceof HTMLTextAreaElement ||
        !!target?.isContentEditable;

      if (typing) {
        if (event.key === "Escape") {
          (target as HTMLElement).blur();
        } else if (event.key === "Enter" && target === searchInput) {
          event.preventDefault();
          searchInput.blur();
          if (!selected) move(1);
        }
        return;
      }

      if (event.metaKey || event.ctrlKey || event.altKey) return;

      const now = Date.now();
      if (event.repeat) {
        // Only motions repeat; holding enter, / or G should not fire twice.
        if (event.key !== "j" && event.key !== "k") return;
        event.preventDefault();
        if (now - lastRepeatAt < REPEAT_MS) return;
        lastRepeatAt = now;
      } else {
        lastRepeatAt = 0;
      }

      const visible = visiblePosts();
      const prevKey = now - lastKeyAt < 600 ? lastKey : "";
      lastKey = event.key;
      lastKeyAt = now;

      switch (event.key) {
        case "j":
          event.preventDefault();
          move(1);
          break;
        case "k":
          event.preventDefault();
          move(-1);
          break;
        case "g":
          if (!event.repeat && prevKey === "g" && visible.length > 0) {
            event.preventDefault();
            select(visible[0]);
            lastKey = "";
          }
          break;
        case "G":
          if (visible.length > 0) {
            event.preventDefault();
            select(visible[visible.length - 1]);
          }
          break;
        case "Enter":
          if (selected) {
            event.preventDefault();
            openSelected();
          }
          break;
        case "/":
          event.preventDefault();
          searchInput.focus();
          searchInput.select();
          break;
        case "Escape":
          select(null);
          break;
      }
    });
  });
</script>
