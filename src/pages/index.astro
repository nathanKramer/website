---
import Layout from "../layouts/Layout.astro";
import banner from "../../public/banner-tight.jpg";
import { getEntry } from "astro:content";

const pinnedPost = await getEntry("blog", "1-values");
---

<Layout title="Nathan Kramer">
    <img class="hidden md:block" src={banner.src} alt="banner" />
    <main>
        <article>
            <div class="intro">
                <img src="./face.jpg" class="profile-photo" alt="profile photo" />
                <div class="intro-text">
                    <h1>Nathan Kramer</h1>
                    <p class="tagline">Software engineer and hobbyist musician from New Zealand</p>
                </div>
            </div>

            {pinnedPost && (
                <section class="pinned-post">
                    <a href={`/blog/${pinnedPost.slug}`} class="pinned-link">
                        <span class="pinned-title">
                            <svg class="pin-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                <path d="M16 12V4h1V2H7v2h1v8l-2 2v2h5.2v6h1.6v-6H18v-2l-2-2z"/>
                            </svg>
                            {pinnedPost.data.title}
                        </span>
                        <span class="pinned-description">{pinnedPost.data.description}</span>
                    </a>
                </section>
            )}

            <section class="pinned-post">
                <a href="https://fanlink.tv/NKEP1" class="pinned-link" target="_blank" rel="noopener noreferrer">
                    <span class="pinned-title">
                        <svg class="pin-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                            <path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"/>
                        </svg>
                        Music
                    </span>
                    <span class="pinned-description">Listen to my EP: "Dialectic I"</span>
                </a>
            </section>

            <section class="pinned-post">
                <a href="/starship-kepler" class="pinned-link">
                    <span class="pinned-title">
                        <svg class="pin-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                            <path d="M21 6H3c-1.1 0-2 .9-2 2v8c0 1.1.9 2 2 2h18c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm-10 7H8v3H6v-3H3v-2h3V8h2v3h3v2zm4.5 2c-.83 0-1.5-.67-1.5-1.5S14.67 12 15.5 12s1.5.67 1.5 1.5S16.33 15 15.5 15zm3-3c-.83 0-1.5-.67-1.5-1.5S17.67 10 18.5 10s1.5.67 1.5 1.5S19.33 12 18.5 12z"/>
                        </svg>
                        Games
                    </span>
                    <span class="pinned-description">Starship Kepler — an intense arcade shooter</span>
                </a>
            </section>
        </article>
    </main>
</Layout>

<style>
    ul {
        list-style: none;
        padding: 0;
        margin: 20px 0;
    }

    ul li {
        padding-left: 20px;
        position: relative;
    }

    ul li::before {
        content: "•";
        position: absolute;
        left: 0;
        top: 0;
    }

    a {
        color: #f15125;
    }

    .intro {
        display: flex;
        align-items: center;
        gap: 1.5rem;
    }

    .intro-text {
        flex: 1;
    }

    .intro-text h1 {
        margin: 0;
    }

    .tagline {
        color: #aaaaaa;
        margin: 0.5rem 0 0 0;
        font-size: 1.1rem;
    }

    .profile-photo {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        flex-shrink: 0;
    }

    main {
        margin: auto;
        padding: 1.5rem;
        max-width: 90ch;
        color: #aaaaaa;
    }

    main article {
        font-family: "Open Sans", sans-serif;
        font-size: 18px;
        line-height: 1.5;
    }

    main article h1,
    main article h2,
    main article h3 {
        font-weight: bold;
        margin-top: 20px;
        margin-bottom: 10px;
    }

    main article h1 {
        color: #eeeeee;
        font-size: 36px;
    }

    main article h2 {
        color: #eeeeee;
        font-size: 20px;
    }

    main article h3 {
        color: #eeeeee;
        font-size: 24px;
    }

    h1 {
        font-size: 3rem;
        font-weight: 800;
        margin: 0;
    }

    .pinned-post {
        margin-top: 2rem;
    }

    .pinned-post + .pinned-post {
        margin-top: 0.75rem;
    }

    .pinned-link {
        display: block;
        padding: 1rem;
        border: 1px solid #333;
        border-radius: 0.5rem;
        text-decoration: none;
        background-color: rgba(255, 255, 255, 0.02);
        transition: border-color 0.3s ease, background-color 0.3s ease;
    }

    .pinned-link:hover {
        border-color: #f15125;
        background-color: rgba(241, 81, 37, 0.05);
    }

    .pinned-title {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: #eeeeee;
        font-size: 1.25rem;
        font-weight: 700;
        transition: color 0.3s ease;
    }

    .pin-icon {
        width: 1.1rem;
        height: 1.1rem;
        flex-shrink: 0;
    }

    .pinned-link:hover .pinned-title {
        color: #f15125;
    }

    .pinned-description {
        display: block;
        color: #aaaaaa;
        font-size: 0.95rem;
        margin-top: 0.25rem;
    }
</style>
